@startuml 12_cumplimiento_asfi_clases
' ============================================================
'  MODULO 12: Cumplimiento Regulatorio, PLD/FT, Consumidor
'             Financiero y Riesgo Operativo
'  Diagrama de CLASES  (modelo detallado)
'  Cubre: RN-27 (debida diligencia por riesgo), RN-28 (monitoreo
'         y reporte de operaciones), RN-29 (atencion de reclamos
'         con plazos), RN-30 (registro de perdidas operativas)
'  Principio rector: cumplir no es tener politicas escritas en
'  un PDF. Es poder DEMOSTRAR, con datos, que cada control se
'  ejecuto, cuando, sobre quien, con que resultado y quien lo
'  reviso. Todo control que no deja fila no existe para un
'  supervisor.
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam DefaultFontName "Helvetica"
skinparam DefaultFontSize 12
skinparam packageStyle rectangle
left to right direction
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 55
hide empty members
skinparam class {
  BackgroundColor #F4F6F7
  BorderColor #34495E
  ArrowColor #2C3E50
  HeaderBackgroundColor #1F5673
  FontColor #1B2631
}
skinparam package {
  BackgroundColor #FBFCFC
  BorderColor #85929E
  FontColor #1F5673
}

title Modulo 12 - Cumplimiento, PLD/FT, Consumidor Financiero y Riesgo Operativo (clases)

legend top right
  <b>Los cuatro circuitos del modulo</b>
  1) Conocer:   MatrizRiesgo -> Calificacion -> DebidaDiligencia
  2) Vigilar:   ReglaMonitoreo -> Alerta -> Caso -> ROS
  3) Reportar:  CatalogoReporte -> Reporte -> Envio -> Acuse
  4) Responder: Reclamo -> Instancia -> Resolucion
  Transversal: riesgo operativo, controles y hallazgos.
endlegend

' ============================================================
package "Conocimiento del cliente (debida diligencia)" {

  enum NivelRiesgoCliente {
    BAJO
    MEDIO
    ALTO
  }

  enum TipoDebidaDiligencia {
    SIMPLIFICADA
    ESTANDAR
    AMPLIADA
    REFORZADA
    CONTINUA
  }

  class MatrizRiesgoLft <<Pol>> {
    - id: UUID
    - version: Integer
    - dimension: String <<CLIENTE | PRODUCTO | CANAL | ZONA_GEOGRAFICA>>
    - factor: String
    - ponderacion: Decimal
    - escala: Json
    - vigenteDesde: Date
    - aprobadaPor: UUID
    --
    + puntuar(usuario): Decimal
  }

  class FactorRiesgoEvaluado <<VO>> {
    - id: UUID
    - usuarioId: UUID
    - matrizRiesgoId: UUID
    - dimension: String
    - factor: String
    - valorObservado: String
    - puntaje: Decimal
    - evaluadoEn: DateTime
  }

  class CalificacionRiesgoCliente <<AR>> {
    - id: UUID
    - usuarioId: UUID
    - matrizRiesgoId: UUID
    - nivel: NivelRiesgoCliente
    - puntajeTotal: Decimal
    - nivelDdRequerido: TipoDebidaDiligencia
    - periodicidadRevisionMeses: Integer
    - vigenteDesde: DateTime
    - proximaRevision: Date
    - esAutomatica: Boolean
    - motivoCambio: String
    --
    + recalcular(): NivelRiesgoCliente
    + exigeRevision(): Boolean
  }

  class DebidaDiligencia <<AR>> {
    - id: UUID
    - usuarioId: UUID
    - tipo: TipoDebidaDiligencia
    - verificacionKycId: UUID <<M1>>
    - documentosRequeridos: Json
    - documentosRecibidos: Json
    - estado: String <<PENDIENTE | EN_PROCESO | COMPLETA | OBSERVADA | RECHAZADA | VENCIDA>>
    - aprobadaPor: UUID
    - segundaRevisionPor: UUID
    - iniciadaEn: DateTime
    - completadaEn: DateTime
    - venceEn: DateTime
    --
    + faltantes(): List
    + aprobar(revisor)
    + observar(motivo)
  }

  class PerfilTransaccional {
    - id: UUID
    - usuarioId: UUID
    - tipo: String <<DECLARADO | OBSERVADO>>
    - montoMensualEstimado: Decimal
    - cantidadOperacionesEstimada: Integer
    - actividadEconomica: String
    - codigoCiiu: String
    - origenFondosDeclarado: String
    - moneda: String
    - vigenteDesde: DateTime
    - fuente: String
    --
    + comparar(observado): DesvioPerfil
  }

  class DesvioPerfil {
    - id: UUID
    - usuarioId: UUID
    - perfilTransaccionalId: UUID
    - periodo: String
    - montoObservado: Decimal
    - montoEsperado: Decimal
    - desvioPorcentual: Decimal
    - severidad: String
    - estado: String
    - justificacion: String
    --
    + generaAlerta(): Boolean
  }

  class DeclaracionPep {
    - id: UUID
    - usuarioId: UUID
    - esPep: Boolean
    - tipoPep: String <<NACIONAL | EXTRANJERO | ORG_INTERNACIONAL | FAMILIAR | ALLEGADO>>
    - cargo: String
    - institucion: String
    - pais: String
    - desde: Date
    - hasta: Date
    - verificadaPor: UUID
    --
    + vigente(): Boolean
  }

  class BeneficiarioFinal {
    - id: UUID
    - usuarioId: UUID
    - nombre: String
    - documento: String
    - porcentajeParticipacion: Decimal
    - tipoControl: String
    - verificado: Boolean
  }

  class DeclaracionOrigenFondos {
    - id: UUID
    - usuarioId: UUID
    - transaccionId: UUID <<M10>>
    - monto: Decimal
    - origen: String <<SALARIO | NEGOCIO | VENTA_BIEN | HERENCIA | PRESTAMO | REMESA | OTRO>>
    - descripcion: String
    - documentoRespaldoUrl: String
    - hashDocumento: String
    - estado: String
    - verificadaPor: UUID
    --
    + requiereRespaldo(): Boolean
  }

  class RevisionPeriodicaKyc {
    - id: UUID
    - usuarioId: UUID
    - calificacionRiesgoId: UUID
    - fechaProgramada: Date
    - fechaEjecutada: Date
    - resultado: String
    - estado: String
    --
    + estaVencida(): Boolean
  }

  class ExpedienteCliente {
    - id: UUID
    - usuarioId: UUID
    - completitudPorcentaje: Decimal
    - documentos: Json
    - ubicacionFisica: String
    - retencionHasta: Date <<no menor a 10 anios desde el ultimo asiento contable>>
    - estado: String
    --
    + faltantes(): List
    + puedeDepurarse(): Boolean
  }

  MatrizRiesgoLft "1" o-- "0..*" FactorRiesgoEvaluado
  MatrizRiesgoLft "1" o-- "0..*" CalificacionRiesgoCliente
  CalificacionRiesgoCliente "1" o-- "0..*" RevisionPeriodicaKyc
  CalificacionRiesgoCliente "1" o-- "0..*" DebidaDiligencia
  PerfilTransaccional "1" o-- "0..*" DesvioPerfil
}

' ============================================================
package "Monitoreo y reporte de operaciones" {

  class ReglaMonitoreoLft <<Pol>> {
    - id: UUID
    - codigo: String
    - tipologia: String
    - descripcion: String
    - expresion: Json <<declarativa>>
    - ventanaEvaluacion: String
    - umbralMonto: Decimal
    - umbralCantidad: Integer
    - severidad: String
    - accionAutomatica: String
    - fuenteNormativa: String
    - activa: Boolean
    - vigenteDesde: DateTime
    --
    + evaluar(contexto): Boolean
  }

  class AlertaMonitoreoLft {
    - id: UUID
    - reglaMonitoreoId: UUID
    - usuarioId: UUID
    - cuentaBilleteraId: UUID <<M10>>
    - transaccionId: UUID <<M10>>
    - montoInvolucrado: Decimal
    - detalle: Json
    - severidad: String
    - estado: String <<ABIERTA | EN_ANALISIS | DESCARTADA | ESCALADA>>
    - asignadaA: UUID
    - casoId: UUID
    - detectadaEn: DateTime
    - cerradaEn: DateTime
    - conclusion: String
    --
    + escalar(): CasoInvestigacionLft
    + descartar(motivo)
  }

  class CasoInvestigacionLft <<AR>> {
    - id: UUID
    - codigo: String
    - usuarioId: UUID
    - analistaId: UUID
    - origen: String <<ALERTA | REQUERIMIENTO | DENUNCIA | REVISION_PERIODICA>>
    - estado: String
    - prioridad: String
    - resumen: String
    - hallazgos: String
    - decision: String <<DESCARTAR | MONITOREO_REFORZADO | REPORTAR | TERMINAR_RELACION>>
    - reporteOperacionSospechosaId: UUID <<M9>>
    - abiertoEn: DateTime
    - plazoLimite: DateTime
    - cerradoEn: DateTime
    - revisadoPor: UUID
    --
    + agregarAlerta(alerta)
    + decidir(decision, justificacion)
    + vencido(): Boolean
  }

  class UmbralReporteUif <<Pol>> {
    - id: UUID
    - formulario: String <<PCC-01 | ROG-01 | ROG-02 | ROG-03 | ROG-04>>
    - inciso: String <<a, b, c ... del articulo>>
    - conceptoOperacion: String <<EFECTIVO | CAMBIO_MONEDA | GIRO | REMESA | CARGA_BILLETERA | RETIRO_BILLETERA | TRANSFERENCIA_BILLETERA | ELECTRONICA | ACTIVO_VIRTUAL>>
    - esAcumulado: Boolean
    - umbralUsd: Decimal
    - ventanaDiasCalendario: Integer
    - exigeDeclaracionOrigenDestino: Boolean
    - baseNormativa: String <<articulo del instructivo UIF>>
    - vigenteDesde: Date
    - vigenteHasta: Date
    --
    + evalua(operacion, acumulado): Boolean
  }

  class RegistroOperacionRelevante <<VO>> {
    - id: UUID
    - usuarioId: UUID
    - transaccionId: UUID <<M10>>
    - umbralReporteId: UUID
    - formulario: String
    - esAcumulada: Boolean
    - operacionInicioVentanaId: UUID <<reinicio tras superar umbral>>
    - ventanaDesde: Date
    - ventanaHasta: Date
    - monto: Decimal
    - montoAcumuladoVentana: Decimal
    - montoEquivalenteUsd: Decimal
    - tipoCambioAplicado: Decimal
    - umbralAplicadoUsd: Decimal
    - declaracionOrigenFondosId: UUID
    - origenDeclarado: String
    - destinoDeclarado: String
    - exento: Boolean
    - motivoExencion: String
    - periodoRemision: String <<YYYY-MM, se remite hasta el 15 del mes siguiente>>
    - reporteRegulatorioId: UUID
    - fechaOperacion: DateTime
    --
    + cierraVentana(): Boolean
  }

  UmbralReporteUif "1" o-- "0..*" RegistroOperacionRelevante

  ReglaMonitoreoLft "1" o-- "0..*" AlertaMonitoreoLft
  CasoInvestigacionLft "1" o-- "0..*" AlertaMonitoreoLft
}

' ============================================================
package "Reportes al regulador" {

  class CatalogoReporteRegulatorio <<Pol>> {
    - id: UUID
    - codigo: String
    - organismo: String <<ASFI | UIF | SIN | BCB>>
    - nombre: String
    - periodicidad: String <<DIARIA | SEMANAL | MENSUAL | TRIMESTRAL | ANUAL | EVENTUAL>>
    - formato: String
    - plazoDias: Integer
    - baseNormativa: String
    - obligatorio: Boolean
    - activo: Boolean
    --
    + proximoVencimiento(fecha): Date
  }

  class ReporteRegulatorio <<AR>> {
    - id: UUID
    - catalogoReporteId: UUID
    - periodo: String
    - fechaCorte: Date
    - estado: String <<PENDIENTE | GENERADO | REVISADO | APROBADO | ENVIADO | OBSERVADO | RECHAZADO>>
    - cantidadRegistros: Integer
    - montoTotal: Decimal
    - urlArchivo: String
    - hashArchivo: String
    - generadoPor: UUID
    - revisadoPor: UUID
    - aprobadoPor: UUID
    --
    + generar()
    + aprobar(revisor)
    + estaVencido(): Boolean
  }

  class EnvioRegulatorio {
    - id: UUID
    - reporteRegulatorioId: UUID
    - organismo: String
    - canal: String
    - fechaEnvio: DateTime
    - numeroConstancia: String
    - estado: String
    - respuesta: Json
    - reintentos: Integer
    --
    + enviar()
    + registrarAcuse(constancia)
  }

  class ObservacionRegulatoria {
    - id: UUID
    - envioRegulatorioId: UUID
    - organismo: String
    - tipo: String <<OBSERVACION | INSTRUCCION | MULTA | REQUERIMIENTO>>
    - numeroDocumento: String
    - descripcion: String
    - montoMulta: Decimal
    - plazoRespuesta: Date
    - estado: String
    - respuesta: String
    --
    + responder(texto, evidencia)
    + venceEn(): Integer
  }

  class RequerimientoAutoridad <<AR>> {
    - id: UUID
    - autoridad: String <<FISCALIA | UIF | ASFI | JUZGADO | SIN | POLICIA>>
    - numeroOficio: String
    - fechaRecepcion: DateTime
    - plazoRespuesta: DateTime
    - usuarioAfectadoId: UUID
    - alcance: String
    - documentoUrl: String
    - hashDocumento: String
    - estado: String
    - respuestaUrl: String
    - bloqueoSaldoId: UUID <<M10>>
    - respondidoPor: UUID
    --
    + responder(documento)
    + generarBloqueo(): BloqueoSaldo
  }

  CatalogoReporteRegulatorio "1" o-- "0..*" ReporteRegulatorio
  ReporteRegulatorio "1" o-- "0..*" EnvioRegulatorio
  EnvioRegulatorio "1" o-- "0..*" ObservacionRegulatoria
}

' ============================================================
package "Consumidor financiero" {

  class ContratoAdhesion <<AR>> {
    - id: UUID
    - codigo: String
    - version: Integer
    - tipo: String <<BILLETERA | GRUPO_PASANAKU | TARIFAS | TRATAMIENTO_DATOS>>
    - estado: String
    - urlDocumento: String
    - hashDocumento: String
    - registradoAnteRegulador: Boolean
    - numeroRegistro: String
    - fechaRegistro: Date
    - vigenteDesde: DateTime
    - vigenteHasta: DateTime
    --
    + publicar()
    + sustituirPor(nuevo)
  }

  class AceptacionContrato <<VO>> {
    - id: UUID
    - contratoAdhesionId: UUID
    - usuarioId: UUID
    - versionAceptada: Integer
    - ip: String
    - dispositivoId: UUID <<M1>>
    - tokenFirmaId: UUID <<M1>>
    - hashEvidencia: String
    - aceptadoEn: DateTime
    --
    + verificarEvidencia(): Boolean
  }

  class DocumentoPublicado {
    - id: UUID
    - tipo: String <<TARIFARIO | CONTRATO | POLITICA_PRIVACIDAD | CANAL_RECLAMOS | HORARIOS>>
    - referenciaTipo: String
    - referenciaId: UUID
    - urlPublica: String
    - hashDocumento: String
    - vigenteDesde: DateTime
    - vigenteHasta: DateTime
    --
    + estaVigente(): Boolean
  }

  class PuntoReclamo {
    - id: UUID
    - codigo: String
    - tipo: String <<APP | WEB | TELEFONO | PRESENCIAL | CORREO>>
    - descripcion: String
    - horario: String
    - responsableId: UUID
    - activo: Boolean
  }

  class ReclamoCliente <<AR>> {
    - id: UUID
    - codigo: String
    - usuarioId: UUID
    - puntoReclamoId: UUID
    - categoria: String <<COMISION | OPERACION_NO_RECONOCIDA | SALDO | SERVICIO | DATOS_PERSONALES | GRUPO>>
    - producto: String
    - montoReclamado: Decimal
    - descripcion: String
    - estado: String <<INGRESADO | EN_ANALISIS | RESPONDIDO | CERRADO | ELEVADO>>
    - fechaIngreso: DateTime
    - plazoRespuesta: DateTime
    - fechaRespuesta: DateTime
    - resultado: String <<FAVORABLE | DESFAVORABLE | PARCIAL | DESISTIDO>>
    - respuesta: String
    - responsableId: UUID
    - ticketSoporteId: UUID <<M9>>
    - devolucionComisionId: UUID <<M11>>
    --
    + responder(texto)
    + elevar(instancia)
    + estaVencido(): Boolean
  }

  class InstanciaReclamo {
    - id: UUID
    - reclamoId: UUID
    - instancia: String <<ENTIDAD | DEFENSORIA | REGULADOR | ARBITRAJE | JUDICIAL>>
    - fechaElevacion: DateTime
    - numeroExpediente: String
    - estado: String
    - resolucion: String
    - fechaResolucion: DateTime
    - montoResarcido: Decimal
  }

  ContratoAdhesion "1" o-- "0..*" AceptacionContrato
  PuntoReclamo "1" o-- "0..*" ReclamoCliente
  ReclamoCliente "1" o-- "0..*" InstanciaReclamo
}

' ============================================================
package "Riesgo operativo y control interno" {

  class EventoRiesgoOperativo <<AR>> {
    - id: UUID
    - codigo: String
    - categoriaEvento: String <<FRAUDE_INTERNO | FRAUDE_EXTERNO | RELACIONES_LABORALES | CLIENTES_PRODUCTOS_PRACTICAS | DANOS_ACTIVOS | FALLAS_SISTEMAS>>
    - factorRiesgo: String <<PROCESOS_INTERNOS | PERSONAS | TECNOLOGIA_INFORMACION | EVENTOS_EXTERNOS | INFRAESTRUCTURA>>
    - reportadoCentralRiesgoOperativo: Boolean
    - lineaNegocio: String
    - descripcion: String
    - fechaOcurrencia: DateTime
    - fechaDeteccion: DateTime
    - fechaContabilizacion: DateTime
    - perdidaBruta: Decimal
    - recuperacion: Decimal
    - perdidaNeta: Decimal
    - causaRaiz: String
    - incidenteOperativoId: UUID <<M9>>
    - estado: String
    --
    + registrarRecuperacion(monto)
    + cerrar()
  }

  class ControlInterno <<Pol>> {
    - id: UUID
    - codigo: String
    - proceso: String
    - descripcion: String
    - tipo: String <<PREVENTIVO | DETECTIVO | CORRECTIVO>>
    - frecuencia: String
    - automatizado: Boolean
    - riesgoMitigado: String
    - responsableId: UUID
    - activo: Boolean
    --
    + proximaEjecucion(): Date
  }

  class PruebaControl {
    - id: UUID
    - controlId: UUID
    - periodo: String
    - tamanioMuestra: Integer
    - excepciones: Integer
    - resultado: String <<EFECTIVO | DEFICIENTE | NO_EFECTIVO>>
    - evidenciaUrl: String
    - ejecutadaPor: UUID
    --
    + generaHallazgo(): Boolean
  }

  class HallazgoAuditoria {
    - id: UUID
    - codigo: String
    - origen: String <<AUDITORIA_INTERNA | AUDITORIA_EXTERNA | REGULADOR | AUTOEVALUACION>>
    - descripcion: String
    - severidad: String
    - proceso: String
    - fechaIdentificacion: Date
    - plazoRegularizacion: Date
    - estado: String
    - responsableId: UUID
    --
    + estaVencido(): Boolean
  }

  class PlanAccionRiesgo {
    - id: UUID
    - eventoRiesgoId: UUID
    - hallazgoId: UUID
    - descripcion: String
    - responsableId: UUID
    - fechaCompromiso: Date
    - fechaCierre: Date
    - avancePorcentaje: Decimal
    - estado: String
    - evidenciaUrl: String
    --
    + actualizar(avance, evidencia)
  }

  class EvaluacionRiesgoProducto {
    - id: UUID
    - producto: String
    - version: Integer
    - riesgosIdentificados: Json
    - nivelRiesgoLft: String
    - controlesDefinidos: Json
    - requiereNoObjecion: Boolean
    - estado: String
    - aprobadaPor: UUID
    - fechaAprobacion: Date
    --
    + habilitaLanzamiento(): Boolean
  }

  class OficialCumplimiento {
    - id: UUID
    - usuarioId: UUID
    - tipo: String <<TITULAR | SUPLENTE>>
    - fechaDesignacion: Date
    - actaDesignacion: String
    - comunicadaAlReguladorEn: Date
    - fechaBaja: Date
    - activo: Boolean
  }

  class CapacitacionCumplimiento {
    - id: UUID
    - usuarioId: UUID
    - tema: String
    - modalidad: String
    - horas: Decimal
    - fecha: Date
    - calificacion: Decimal
    - aprobada: Boolean
    - evidenciaUrl: String
    - periodo: String
  }

  ControlInterno "1" o-- "0..*" PruebaControl
  EventoRiesgoOperativo "1" o-- "0..*" PlanAccionRiesgo
  HallazgoAuditoria "1" o-- "0..*" PlanAccionRiesgo
}

' ============================================================
package "Gobierno, licencia, seguridad y continuidad" {

  class LicenciaRegulatoria <<AR>> {
    - id: UUID
    - organismo: String <<ASFI | BCB | SIN>>
    - tipo: String <<CERTIFICADO_ADECUACION | LICENCIA_FUNCIONAMIENTO | AUTORIZACION_ESPECIFICA>>
    - categoriaActividad: String <<PAGOS_Y_PLATAFORMAS_DE_PAGO | BLOCKCHAIN_PSAV | PLATAFORMAS_FINANCIAMIENTO | TECNOLOGIAS_EMPRESARIALES>>
    - numeroResolucion: String
    - estado: String <<EN_TRAMITE | OTORGADA | CONDICIONADA | SUSPENDIDA | REVOCADA>>
    - fechaSolicitud: Date
    - fechaOtorgamiento: Date
    - vigenteHasta: Date
    - alcanceAutorizado: Json
    - garantiaSeriedad: Decimal
    - documentoUrl: String
    - hashDocumento: String
    --
    + habilitaServicio(codigo): Boolean
    + estaVigente(): Boolean
  }

  class EntornoPruebaRegulado {
    - id: UUID
    - licenciaRegulatoriaId: UUID
    - servicioEnPrueba: String
    - alcance: Json
    - limiteUsuarios: Integer
    - limiteMontoOperacion: Decimal
    - garantiaConstituida: Decimal
    - fechaInicio: Date
    - fechaFin: Date
    - estado: String
    - informesRemitidos: Integer
    --
    + dentroDeLimites(operacion): Boolean
  }

  class PoliticaInterna <<Pol>> {
    - id: UUID
    - codigo: String
    - tipo: String <<MANUAL | POLITICA | PROCEDIMIENTO | METODOLOGIA | PLAN>>
    - materia: String <<LGI_FT | RIESGO_OPERATIVO | SEGURIDAD_INFORMACION | CONTINUIDAD | CONSUMIDOR | TERCERIZACION>>
    - version: Integer
    - estado: String
    - urlDocumento: String
    - hashDocumento: String
    - aprobadaPorDirectorio: Boolean
    - actaComiteId: UUID
    - vigenteDesde: Date
    - proximaRevision: Date
    --
    + estaVencida(): Boolean
  }

  class ComiteGobierno {
    - id: UUID
    - tipo: String <<DIRECTORIO | RIESGOS | CUMPLIMIENTO | AUDITORIA | SEGURIDAD_INFORMACION>>
    - periodicidadMinima: String
    - composicionRequerida: Json
    - activo: Boolean
    --
    + cumpleQuorum(asistentes): Boolean
  }

  class ActaComite {
    - id: UUID
    - comiteGobiernoId: UUID
    - numero: String
    - fecha: Date
    - asistentes: Json
    - temasTratados: Json
    - decisiones: Json
    - urlDocumento: String
    - hashDocumento: String
    --
    + verificarQuorum(): Boolean
  }

  class DesignacionRegulatoria {
    - id: UUID
