{
  "name": "@aportaya/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Sistema de diseño de AportaYa (fase F1): tokens, formateo de dinero y átomos. Lo consumen los tres productos.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web/index.ts",
    "./web/atomos.css": "./src/web/atomos.css",
    "./nativo": "./src/nativo/index.ts",
    "./tokens.css": "./generado/tokens.css"
  },
  "scripts": {
    "build": "node scripts/tokens-a-css.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test:front": "vitest run --project unidad --project componente",
    "test:a11y": "vitest run --project a11y"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-native": ">=0.81"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "jest-axe": "^11.0.0",
    "jsdom": "^28.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.0",
    "yaml": "^2.9.0"
  }
}
