# Sitio publico — construccion multietapa, sin root.
#
#   docker build -f apps/web/docker/Dockerfile.web .      (contexto: la raiz del monorepo)
#
# El contexto es la RAIZ y no `apps/web` porque el sitio es un espacio de trabajo de
# yarn: depende de `@aportaya/simulado` y del `tsconfig.base.json`. Construirlo desde
# su propia carpeta obligaria a copiar esas dos cosas adentro, y una copia se
# desactualiza.
#
# Sirve con Node y no con NGINX a secas: la ruta de plazos —y manana las de
# verificacion— son SSR. NGINX sigue siendo la unica entrada publica del sistema, por
# delante de este proceso (ADR-025).

# ---------------------------------------------------------------- 1 · dependencias
FROM node:22-alpine AS dependencias
WORKDIR /construccion

# Solo los manifiestos primero: asi la capa de dependencias se reutiliza mientras no
# cambie un `package.json`, que es casi siempre.
COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/movil/package.json apps/movil/
COPY apps/backoffice/package.json apps/backoffice/
COPY apps/web/package.json apps/web/
COPY packages/simulado/package.json packages/simulado/
RUN corepack enable && yarn install --immutable

# ---------------------------------------------------------------- 2 · construccion
FROM node:22-alpine AS construccion
WORKDIR /construccion

COPY --from=dependencias /construccion/node_modules node_modules
COPY package.json yarn.lock .yarnrc.yml tsconfig.base.json ./
COPY packages/simulado packages/simulado
COPY apps/web apps/web

# Los contratos en JSON son GENERADOS del .yaml de cada servicio. Aca no estan los
# servicios, asi que se crea el directorio vacio: el sitio publicado no simula nada
# —el simulado es de desarrollo— y sin esto el paquete no resuelve el import.
RUN mkdir -p packages/simulado/generado \
    && printf '%s' '{"openapi":"3.1.0","info":{"title":"vacio","version":"0"},"paths":{}}' \
       | tee packages/simulado/generado/identidad.json \
             packages/simulado/generado/grupos.json \
             packages/simulado/generado/notificaciones.json \
             packages/simulado/generado/nucleo-financiero.json > /dev/null

RUN corepack enable && yarn workspace @aportaya/web build

# ---------------------------------------------------------------- 3 · ejecucion
FROM node:22-alpine AS ejecucion
WORKDIR /sitio

# Sin root. El proceso no necesita escribir nada: sirve lo que se construyo.
ENV NODE_ENV=production HOST=0.0.0.0 PORT=4321
USER node

COPY --from=construccion --chown=node:node /construccion/apps/web/dist ./dist
COPY --from=construccion --chown=node:node /construccion/node_modules ./node_modules

EXPOSE 4321

# La sonda mira el sitio, no el proceso: un Node vivo que devuelve 500 en la portada
# no es un sitio en pie.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "fetch('http://127.0.0.1:'+process.env.PORT+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "./dist/server/entry.mjs"]
