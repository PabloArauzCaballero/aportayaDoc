{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "vitest/globals",
      "@testing-library/jest-dom"
    ],
    "baseUrl": "../..",
    "paths": {
      "@/*": [
        "apps/web/src/*"
      ],
      "@aportaya/simulado": [
        "packages/simulado/src/index.ts"
      ],
      "@aportaya/simulado/*": [
        "packages/simulado/src/*"
      ],
      "@aportaya/ui": [
        "packages/ui/src/index.ts"
      ],
      "@aportaya/ui/nativo": [
        "packages/ui/src/nativo/index.ts"
      ],
      "@aportaya/ui/web": [
        "packages/ui/src/web/index.ts"
      ],
      "clientes/typescript/*": [
        "clientes/typescript/*"
      ]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "pruebas/**/*",
    "*.mjs",
    "*.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
