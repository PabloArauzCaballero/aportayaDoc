{
  "name": "aportaya",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:movil": "yarn workspace @aportaya/movil start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:front": "turbo run test:front",
    "test:a11y": "turbo run test:a11y",
    "build": "turbo run build"
  },
  "devDependencies": {
    "turbo": "^2.10.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
